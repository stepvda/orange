# Secrets — never commit
.env
*.key

# Data & artefacts
# `data/` on its own would stop git descending into the directory at all, so the
# negation below could never take effect — hence `data/*`.
data/*
!data/.gitkeep
*.sqlite3
*.duckdb
archive/
.cache/

# The radar database is not committed as a raw file: at ~126 MB it exceeds
# GitHub's hard 100 MB per-file limit, so a push carrying it is rejected
# outright. What is committed is data/db-archive/ — the same database taken with
# VACUUM INTO (a plain copy of a WAL-mode file can miss committed pages) and
# deflated into a split zip whose parts are capped at 25 MB, comfortably under
# GitHub's 50 MB warning as well as the hard limit. Build it with
# scripts/db-archive-pack.sh, unpack it with scripts/db-archive-restore.sh.
#
# The archive is a convenience copy, not the source of truth. The database is
# rebuilt by every pipeline run, and the deployed instance is seeded from the
# package the deploy script builds (scripts/deploy-azure.sh), not from the
# repository — so re-run the pack script when the committed copy should catch
# up, and expect a fresh ~30 MB blob in history each time it does.
*.db

# The split archive itself. `data/*` above stops git descending into data/, so
# the directory has to be re-included before its contents can be.
!data/db-archive/
!data/db-archive/**

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Models / embeddings cache
.models/
.sentence_transformers/

# OS / editors
.DS_Store
.vscode/
.idea/

# Office lock files. Word and PowerPoint write a `~$name.docx` owner file beside
# any document that is open, and delete it on close. It is a few hundred bytes of
# session state, never content — one was committed in August alongside a deck that
# happened to be open at the time.
~$*

# Scratch dump left beside the docs. Kept on disk, not in the repository: the
# prose in it is generated per space by the pipeline, so the file is a copy of an
# output rather than a source.
docs/tmp.txt
