# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---- LLM provider (NFR-05 / NFR-10: swappable without re-architecture) ----
# Supported: deepseek | openai | ollama | mock
RADAR_LLM_PROVIDER=deepseek

# DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
RADAR_LLM_MODEL_STRONG=deepseek-reasoner
RADAR_LLM_MODEL_CHEAP=deepseek-chat

# OpenAI (alternative)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama / sovereign local deployment (alternative)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- Contact header required/requested by several free APIs ----
RADAR_CONTACT_EMAIL=you@example.com

# ---- Storage ----
RADAR_DB_PATH=data/radar.db
RADAR_ARCHIVE_DIR=data/archive

# ---- Sign-in (src/radar/auth.py) ----
# An empty database seeds one account, orange / orange, flagged to be changed.
# Nothing below has to be set; the defaults are the shipped ones.
#
# PBKDF2 rounds. OWASP's current figure for HMAC-SHA256. Lower it only knowingly,
# on hardware that cannot afford it — it is stamped into every stored hash, so
# raising it later re-hashes each password on its next sign-in.
# RADAR_PBKDF2_ITERATIONS=600000
#
# A session is refreshed on use up to the idle window, and cannot outlive the
# ceiling however often it is used.
# RADAR_SESSION_IDLE_HOURS=12
# RADAR_SESSION_MAX_HOURS=168
#
# Whether the session cookie is marked Secure. Unset, it follows the scheme the
# browser used (x-forwarded-proto first, because App Service terminates TLS at
# the front end). Set it only where the headers are known to be wrong: marking it
# Secure over plain HTTP means the browser discards it and nobody can sign in.
# RADAR_COOKIE_SECURE=true
